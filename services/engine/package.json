{
  "name": "@orzeus/engine",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "orzeusd: the Orzeus orchestration engine. Composition root that wires core ports to concrete adapters and serves @orzeus/protocol over stdio.",
  "bin": {
    "orzeusd": "./dist/main.js",
    "orzeus": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "@orzeus/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "start": "node dist/main.js"
  },
  "dependencies": {
    "@orzeus/checks": "workspace:*",
    "@orzeus/core": "workspace:*",
    "@orzeus/git": "workspace:*",
    "@orzeus/protocol": "workspace:*",
    "@orzeus/providers": "workspace:*",
    "@orzeus/schema": "workspace:*",
    "@orzeus/store": "workspace:*",
    "@orzeus/trace": "workspace:*",
    "zod": "4.6.7"
  }
}
