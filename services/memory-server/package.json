{
  "name": "@orzeus/memory-server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "orzeus-memory: a standalone MCP server (stdio) for persistent repo decisions, constraints and conventions, backed by its own memory.db.",
  "bin": {
    "orzeus-memory": "./dist/main.js"
  },
  "exports": {
    ".": {
      "@orzeus/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./main": {
      "@orzeus/source": "./src/main.ts",
      "types": "./dist/main.d.ts",
      "default": "./dist/main.js"
    }
  },
  "files": [
    "dist"
  ],
  "dependencies": {
    "@modelcontextprotocol/server": "2.4.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "2.4.0"
  }
}
