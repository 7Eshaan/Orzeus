{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Permissions for the main window: core defaults, the engine relay and Keychain commands, and installing signed updates.",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "updater:default",
    "process:allow-restart",
    "allow-engine-send",
    "allow-engine-status",
    "allow-engine-restart",
    "allow-secret-status",
    "allow-secret-set",
    "allow-secret-delete"
  ]
}
